# Скопируйте этот файл как .env и заполните значения.
# .env НЕ коммитится в git!

# ==================== DISCORD BOT ====================
# Токен бота: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# ==================== POSTGRESQL ====================
# Строка подключения к базе. Без неё команды .profile и таблица лидеров не работают.
# Пример: PG_DSN=postgresql://user:password@localhost:5432/ordis
PG_DSN=

# ==================== ADMIN PANEL ====================
# Discord OAuth2: https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/callback

# Flask secret key (любая длинная случайная строка)
FLASK_SECRET_KEY=

# Discord сервер
GUILD_ID=
